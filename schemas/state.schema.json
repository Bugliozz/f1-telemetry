{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://f1-telemetry.local/schemas/state.schema.json",
  "title": "CarState",
  "description": "Car FSM state snapshot, published on-change with retain on topic f1/simulation/{raceId}/teams/{teamId}/cars/{carId}/state.",
  "type": "object",
  "additionalProperties": false,
  "required": ["timestamp", "raceId", "teamId", "carId", "state"],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "raceId": {
      "type": "integer",
      "minimum": 1
    },
    "teamId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}$"
    },
    "carId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99
    },
    "state": {
      "type": "string",
      "enum": ["INIT", "RUNNING", "PIT", "FAULT", "RETIRED", "FINISHED"]
    },
    "previousState": {
      "type": ["string", "null"],
      "enum": ["INIT", "RUNNING", "PIT", "FAULT", "RETIRED", "FINISHED", null]
    },
    "reason": {
      "type": ["string", "null"],
      "maxLength": 128,
      "description": "Textual cause of the state transition (e.g. low-fuel, tire-overheat)."
    }
  }
}
