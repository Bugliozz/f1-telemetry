{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://f1-telemetry.local/schemas/flag.schema.json",
  "title": "RaceControlFlag",
  "description": "Global race control event (flag, safety car) published with retain on f1/simulation/{raceId}/race-control/flags.",
  "type": "object",
  "additionalProperties": false,
  "required": ["timestamp", "raceId", "flag", "active"],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "raceId": {
      "type": "integer",
      "minimum": 1
    },
    "flag": {
      "type": "string",
      "enum": ["GREEN", "YELLOW", "RED", "CHECKERED", "SC", "VSC"]
    },
    "active": {
      "type": "boolean",
      "description": "true when the flag comes into effect, false when it is withdrawn."
    },
    "sector": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 3,
      "description": "Affected sector (e.g. local yellow flag). null for global flags."
    },
    "reason": {
      "type": ["string", "null"],
      "maxLength": 256
    }
  }
}
