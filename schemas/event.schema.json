{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://f1-telemetry.local/schemas/event.schema.json",
  "title": "CarEvent",
  "description": "Discrete car-level event published on topic f1/simulation/{raceId}/teams/{teamId}/cars/{carId}/events.",
  "type": "object",
  "additionalProperties": false,
  "required": ["timestamp", "raceId", "teamId", "carId", "type"],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "raceId": {
      "type": "integer",
      "minimum": 1
    },
    "teamId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}$"
    },
    "carId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99
    },
    "type": {
      "type": "string",
      "enum": [
        "pit-entry",
        "pit-stop",
        "pit-exit",
        "fault",
        "retirement",
        "lap-completed",
        "sector-completed",
        "overtake",
        "state-change"
      ],
      "description": "Event category. The shape of details depends on the type."
    },
    "details": {
      "type": "object",
      "description": "Event-specific payload. Examples: {duration, tyreCompound, service, refuelling} for pit-stop; {lap, lapTime} for lap-completed; {sector, sectorTime} for sector-completed; {from, to, reason} for state-change."
    }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "pit-stop" } } },
      "then": {
        "required": ["details"],
        "properties": {
          "details": {
            "type": "object",
            "additionalProperties": false,
            "required": ["duration", "tyreCompound"],
            "properties": {
              "duration": { "type": "number", "minimum": 0, "maximum": 60 },
              "tyreCompound": { "type": "string", "enum": ["soft", "medium", "hard", "intermediate", "wet"] },
              "service": { "type": "string", "enum": ["tire-change"] },
              "refuelling": { "type": "boolean" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "lap-completed" } } },
      "then": {
        "required": ["details"],
        "properties": {
          "details": {
            "type": "object",
            "additionalProperties": false,
            "required": ["lap", "lapTime"],
            "properties": {
              "lap": { "type": "integer", "minimum": 1 },
              "lapTime": { "type": "number", "minimum": 0, "description": "Lap time in seconds." }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "sector-completed" } } },
      "then": {
        "required": ["details"],
        "properties": {
          "details": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sector", "sectorTime"],
            "properties": {
              "sector": { "type": "integer", "minimum": 1, "maximum": 3 },
              "sectorTime": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "state-change" } } },
      "then": {
        "required": ["details"],
        "properties": {
          "details": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to"],
            "properties": {
              "from": { "type": "string", "enum": ["INIT", "RUNNING", "PIT", "FAULT", "RETIRED", "FINISHED"] },
              "to": { "type": "string", "enum": ["INIT", "RUNNING", "PIT", "FAULT", "RETIRED", "FINISHED"] },
              "reason": { "type": "string", "maxLength": 128 }
            }
          }
        }
      }
    }
  ]
}
