{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://f1-telemetry.local/schemas/telemetry.schema.json",
  "title": "Telemetry",
  "description": "Telemetry sample published by the simulator on topic f1/simulation/{raceId}/teams/{teamId}/cars/{carId}/telemetry. Frequency 2-5 Hz.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "timestamp",
    "raceId",
    "teamId",
    "carId",
    "compound",
    "lap",
    "trackPos",
    "speed",
    "rpm",
    "gear",
    "throttle",
    "brake",
    "drs",
    "tireTemp",
    "fuel",
    "state"
  ],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC with milliseconds (e.g. 2026-04-27T14:32:10.512Z)."
    },
    "raceId": {
      "type": "integer",
      "minimum": 1,
      "description": "Unique identifier of the simulated race."
    },
    "teamId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}$",
      "description": "Lowercase team slug (e.g. ferrari, mercedes)."
    },
    "carId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99,
      "description": "Car number."
    },
    "compound": {
      "type": "string",
      "enum": ["soft", "medium", "hard"],
      "description": "Current dry tyre compound."
    },
    "lap": {
      "type": "integer",
      "minimum": 0,
      "description": "Current lap (0 before the race start)."
    },
    "trackPos": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Normalised position on the current lap."
    },
    "speed": {
      "type": "number",
      "minimum": 0,
      "maximum": 400,
      "description": "Speed in km/h."
    },
    "rpm": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16000,
      "description": "Engine revolutions per minute."
    },
    "gear": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8,
      "description": "0 = neutral, 1-7 = forward gears, 8 = reverse."
    },
    "throttle": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Throttle pedal position [0,1]."
    },
    "brake": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Brake pedal position [0,1]."
    },
    "drs": {
      "type": "boolean",
      "description": "Digital sensor: DRS active."
    },
    "tireTemp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fl", "fr", "rl", "rr"],
      "properties": {
        "fl": { "type": "number", "minimum": -10, "maximum": 200 },
        "fr": { "type": "number", "minimum": -10, "maximum": 200 },
        "rl": { "type": "number", "minimum": -10, "maximum": 200 },
        "rr": { "type": "number", "minimum": -10, "maximum": 200 }
      },
      "description": "Tyre temperature in °C for each corner (front-left, front-right, rear-left, rear-right)."
    },
    "tireWear": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fl", "fr", "rl", "rr"],
      "properties": {
        "fl": { "type": "number", "minimum": 0, "maximum": 1 },
        "fr": { "type": "number", "minimum": 0, "maximum": 1 },
        "rl": { "type": "number", "minimum": 0, "maximum": 1 },
        "rr": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "description": "Normalised tyre wear [0,1] per corner. 1.0 = fully worn."
    },
    "fuel": {
      "type": "number",
      "minimum": 0,
      "maximum": 40,
      "description": "Remaining fuel in kg. Sprint tank 38 kg (±2 kg delivery jitter), monotonically decreasing, no refuelling."
    },
    "state": {
      "type": "string",
      "enum": ["INIT", "RUNNING", "PIT", "FAULT", "RETIRED", "FINISHED"],
      "description": "Current car FSM state, denormalised for analytics."
    }
  }
}
