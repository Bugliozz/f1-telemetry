node-red/data/flows_cred.json

# ─── Mosquitto ───────────────────────────────────────────────
# Dati di persistenza e log (generati a runtime)
mosquitto/data/
mosquitto/log/

# ─── MongoDB ─────────────────────────────────────────────────
